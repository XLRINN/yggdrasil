[global]
   workgroup = WORKGROUP
   server string = alexandria
   server role = standalone server
   log file = /var/log/samba/log.%m
   max log size = 1000
   logging = file
   panic action = /usr/share/samba/panic-action %d
   obey pam restrictions = yes
   unix password sync = no
   passwd program = /usr/bin/passwd %u
   pam password change = yes
   map to guest = never

[alexandria]
   path = /mnt/mimmis
   browseable = yes
   read only = no
   valid users = david
   force user = david
   create mask = 0664
   directory mask = 0775
