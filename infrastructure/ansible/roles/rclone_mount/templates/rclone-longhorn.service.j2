[Unit]
Description=rclone SFTP mount for njord longhorn backups
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=notify
ExecStartPre=/bin/mkdir -p /mnt/longhorn
ExecStart=/usr/bin/rclone mount njord:/mnt/user/longhorn /mnt/longhorn \
  --config /root/.config/rclone/rclone.conf \
  --vfs-cache-mode writes \
  --allow-other \
  --uid 0 \
  --gid 0
ExecStop=/bin/fusermount -u /mnt/longhorn
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
