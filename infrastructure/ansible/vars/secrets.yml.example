# Copy to secrets.yml and encrypt with: ansible-vault encrypt vars/secrets.yml
tailscale_auth_key: "tskey-auth-..."
samba_user: "shareuser"
samba_password: "changeme"
github_token: "ghp_..."         # needs repo scope for flux bootstrap
ssh_public_key: "ssh-rsa ..."   # public key for david user on all hosts
proxmox_password: "changeme"    # used by rclone SFTP auth to njord
filebrowser_password: "changeme123"  # min 12 chars — Filebrowser web UI password for david
pihole_password: "changeme"     # Pi-hole web UI admin password
cloudflare_tunnel_id: "..."     # Zero Trust → Tunnels → your tunnel → Overview
cloudflare_tunnel_token: "eyJ..." # Zero Trust → Tunnels → your tunnel → Overview → long base64 string after 'service install'
cloudflare_api_token: "..."     # Cloudflare → My Profile → API Tokens → Edit zone DNS (scoped to yggdrasil.rip)
sequence_api_key: "..."         # API key for sequence MCP server (hermod)
actual_budget_sync_id: "..."    # Actual Budget → Settings → Advanced → Sync ID
actual_mcp_token: "..."         # Static bearer token for budget-mcp (generate a random string)
proxmox_homepage_password: "..." # Homepage's root@pam!homepage Proxmox API token secret
jellyfin_api_key: "..."         # Jellyfin → Dashboard → API Keys
sabnzbd_api_key: "..."          # SABnzbd → Config → General → API Key
sonarr_api_key: "..."           # Sonarr → Settings → General → API Key
radarr_api_key: "..."           # Radarr → Settings → General → API Key
prowlarr_api_key: "..."         # Prowlarr → Settings → General → API Key
sonarr_anime_api_key: "..."     # Sonarr (anime instance) → Settings → General → API Key
lidarr_api_key: "..."           # Lidarr → Settings → General → API Key
seer_api_key: "..."             # Overseerr/Seer → Settings → General → API Key
sops_age_key: |                 # contents of your age.key
  # created: ...
  # public key: age1...
  AGE-SECRET-KEY-1...
