# Copy to secrets.yml and encrypt with: ansible-vault encrypt vars/secrets.yml
tailscale_auth_key: "tskey-auth-..."
samba_user: "shareuser"
samba_password: "changeme"
github_token: "ghp_..."         # needs repo scope for flux bootstrap
ssh_public_key: "ssh-rsa ..."   # public key for david user on all hosts
proxmox_password: "changeme"    # used by rclone SFTP auth to njord
filebrowser_password: "changeme123"  # min 12 chars — Filebrowser web UI password for david
pihole_password: "changeme"     # Pi-hole web UI admin password
cloudflare_tunnel_id: "..."     # Zero Trust → Tunnels → your tunnel → Overview
cloudflare_tunnel_token: "eyJ..." # Zero Trust → Tunnels → your tunnel → Overview → long base64 string after 'service install'
sops_age_key: |                 # contents of your age.key
  # created: ...
  # public key: age1...
  AGE-SECRET-KEY-1...
